# Self-host stack env (docs/self-hosting-design.md §8) — copy to .env, then
# fill the three key values with `deploy/scripts/generate-keys.sh`.
# The filled .env holds every deployment secret; never commit it.

# --- public origin ---------------------------------------------------------
# Where the app + /rest/v1 /auth/v1 /realtime/v1 /storage/v1 live. Local
# demo default; on the VPS this is the https origin behind the host proxy.
SITE_ORIGIN=http://localhost:8000
# The only published container port (kong). Change if 8000 is taken.
JDM_ORIGIN_PORT=8000

# --- keys (deploy/scripts/generate-keys.sh) --------------------------------
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me

# --- app image -------------------------------------------------------------
# The compose `app` service pulls this; `docker compose up -d --build` builds
# locally instead. VITE_* are baked into the image at build time (they are
# publishable values — the anon key ships in the client bundle by design).
APP_IMAGE=ghcr.io/whoiscadenyoung/json-data-manager:latest
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=change-me

# --- optional studio profile (--profile studio) ----------------------------
# Bound to host loopback only; reach it through an SSH tunnel.
STUDIO_PORT=54323

# --- view runner (server-side; docs/views-design.md §7) -----------------------
# The app container connects to Postgres as `jdm_server` (a member of the
# `view_runner` role, created on first volume init by
# deploy/postgres/zz-supabase-roles.sh with POSTGRES_PASSWORD; an EXISTING
# volume needs: CREATE ROLE jdm_server LOGIN PASSWORD '...' IN ROLE view_runner;)
# and verifies the caller's access token with JWT_SECRET. Local dev (bun run
# dev) needs the same two values in app/.env.local:
#   DATABASE_URL=postgresql://supabase_admin:<POSTGRES_PASSWORD>@127.0.0.1:54322/app
#   JWT_SECRET=<same as above>
# Statement timeout of a run's read phase, in milliseconds.
VIEW_RUN_TIMEOUT_MS=60000
