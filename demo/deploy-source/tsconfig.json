{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ES2023"],
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "isolatedModules": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"]
}
