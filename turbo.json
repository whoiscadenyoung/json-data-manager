{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["SUPABASE_DB_URL", "DATABASE_URL", "JWT_SECRET", "NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".cache/*.tsbuildinfo", "*.tsbuildinfo"]
    },
    "app#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "app#test": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
