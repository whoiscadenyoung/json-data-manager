exports[`join: summarize > every supported measure, with emptyValue and the count default 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"in_deployments" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $2::uuid
),
"l0" as (
  select row_id, d, geom, (d ->> $3::text) as k0, concat_ws(' | ', (d ->> $3::text)) as kraw
  from "in_states"
),
"r0" as (
  select row_id, d, (d ->> $4::text) as k0, concat_ws(' | ', (d ->> $4::text)) as kraw
  from "in_deployments"
),
"rs0" as (
  select k0, to_jsonb(count(*)) as m0, to_jsonb(count(*) filter (where ((d -> $5::text) is not null and jsonb_typeof((d -> $5::text)) <> 'null'))) as m1, to_jsonb(count(distinct (d -> $6::text)) filter (where ((d -> $6::text) is not null and jsonb_typeof((d -> $6::text)) <> 'null'))) as m2, to_jsonb(sum((case when jsonb_typeof((d -> $5::text)) = 'number' then (d -> $5::text)::numeric end))) as m3, to_jsonb(avg((case when jsonb_typeof((d -> $5::text)) = 'number' then (d -> $5::text)::numeric end))) as m4, (case when count(*) filter (where jsonb_typeof((d -> $5::text)) = 'string') = 0 then to_jsonb(min((case when jsonb_typeof((d -> $5::text)) = 'number' then (d -> $5::text)::numeric end))) else to_jsonb(min((d ->> $5::text))) end) as m5, (case when count(*) filter (where jsonb_typeof((d -> $6::text)) = 'string') = 0 then to_jsonb(max((case when jsonb_typeof((d -> $6::text)) = 'number' then (d -> $6::text)::numeric end))) else to_jsonb(max((d ->> $6::text))) end) as m6
  from "r0"
  group by k0
),
"s0" as (
  select l.row_id, l.d || jsonb_build_object($9::text, coalesce(rs.m0, $7::jsonb), $10::text, coalesce(rs.m1, $7::jsonb), $11::text, rs.m2, $12::text, coalesce(rs.m3, $7::jsonb), $13::text, rs.m4, $14::text, coalesce(rs.m5, $8::jsonb), $15::text, rs.m6) as d, l.geom
  from "l0" l
  left join "rs0" rs on l.k0 = rs.k0
)
select row_id, d as d, geom
from "s0"
-- params: ["11111111-1111-4111-8111-111111111111","22222222-2222-4222-8222-222222222222","id","stateId","cost","name","0","\\"none\\"","n","nCost","agencies","total","mean","lo","hi"]"
`;

