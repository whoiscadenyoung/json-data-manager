exports[`join: first / last > first with orderBy and a field list 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"in_deployments" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $2::uuid
),
"l0" as (
  select row_id, d, geom, (d ->> $3::text) as k0, concat_ws(' | ', (d ->> $3::text)) as kraw
  from "in_states"
),
"r0" as (
  select row_id, d, (d ->> $4::text) as k0, concat_ws(' | ', (d ->> $4::text)) as kraw
  from "in_deployments"
),
"rf0" as (
  select distinct on (k0) row_id, d, k0
  from "r0"
  order by k0, (d -> $5::text) desc nulls last, row_id asc
),
"s0" as (
  select l.row_id, l.d || case when r.row_id is null then '{}'::jsonb else jsonb_build_object($7::text, (r.d -> $6::text), $8::text, (r.d -> $5::text)) end as d, l.geom
  from "l0" l
  left join "rf0" r on l.k0 = r.k0
)
select row_id, d as d, geom
from "s0"
-- params: ["11111111-1111-4111-8111-111111111111","22222222-2222-4222-8222-222222222222","id","stateId","cost","name","deployments_2024.name","deployments_2024.cost"]"
`;

exports[`join: first / last > inner join, explicit prefix and a composite key 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"in_deployments" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $2::uuid
),
"l0" as (
  select row_id, d, geom, (d ->> $3::text) as k0, (d ->> $4::text) as k1, concat_ws(' | ', (d ->> $3::text), (d ->> $4::text)) as kraw
  from "in_states"
),
"r0" as (
  select row_id, d, (d ->> $5::text) as k0, (d ->> $4::text) as k1, concat_ws(' | ', (d ->> $5::text), (d ->> $4::text)) as kraw
  from "in_deployments"
),
"rf0" as (
  select distinct on (k0, k1) row_id, d, k0, k1
  from "r0"
  order by k0, k1, row_id asc
),
"s0" as (
  select l.row_id, l.d || coalesce((select jsonb_object_agg($6::text || t.key, t.value) from jsonb_each(r.d) t), '{}'::jsonb) as d, l.geom
  from "l0" l
  join "rf0" r on l.k0 = r.k0 and l.k1 = r.k1
)
select row_id, d as d, geom
from "s0"
-- params: ["11111111-1111-4111-8111-111111111111","22222222-2222-4222-8222-222222222222","id","name","stateId","dep."]"
`;

