  where (not (((d -> $2::text) is null or jsonb_typeof((d -> $2::text)) = 'null'))) and (((case when jsonb_typeof((d -> $3::text)) = 'number' then (d -> $3::text)::numeric end) > $4::numeric) or ((d -> $2::text) = $5::jsonb))
