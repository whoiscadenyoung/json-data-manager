exports[`sql step > d / row_id / geom columns pass through; input CTEs are emitted on demand 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"in_deployments" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $2::uuid
),
"s0_q" as (
select p.row_id, p.d || jsonb_build_object('n', (select count(*) from in_deployments)) as d, p.geom from "in_states" p
),
"s0" as (
  select f.rid as row_id, f.d, f.geom
  from (select coalesce(to_jsonb(q."d"), '{}'::jsonb) as d, q."geom" as geom, (q."row_id")::text::uuid as rid from "s0_q" q) f
)
select row_id, d as d, geom
from "s0"
-- params: ["11111111-1111-4111-8111-111111111111","22222222-2222-4222-8222-222222222222"]"
`;

exports[`sql step > plain columns are folded into d; prev points at the previous step 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"s0" as (
  select row_id, d, geom
  from "in_states"
  where ((d -> $2::text) is not null and jsonb_typeof((d -> $2::text)) <> 'null')
),
"s1_q" as (
select p.d ->> 'name' as name, (p.d ->> 'cost')::numeric * 2 as double from "s0" p where p.d ->> 'name' is not null
),
"s1" as (
  select md5(f.d::text || ':' || (row_number() over (partition by f.d::text))::text)::uuid as row_id, f.d, f.geom
  from (select jsonb_build_object($2::text, to_jsonb(q."name"), $3::text, to_jsonb(q."double")) as d, null::geometry(Geometry,4326) as geom, null::uuid as rid from "s1_q" q) f
)
select row_id, d as d, geom
from "s1"
-- params: ["11111111-1111-4111-8111-111111111111","name","double"]"
`;

exports[`sql step > select * from prev keeps row_id, d and geom 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"s0_q" as (
select * from "in_states" as prev -- trailing comment
),
"s0" as (
  select f.rid as row_id, f.d, f.geom
  from (select coalesce(to_jsonb(q."d"), '{}'::jsonb) as d, q."geom" as geom, (q."row_id")::text::uuid as rid from "s0_q" q) f
)
select row_id, d as d, geom
from "s0"
-- params: ["11111111-1111-4111-8111-111111111111"]"
`;
