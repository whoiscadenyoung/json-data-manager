exports[`groupBy and select > groupBy drops geometry and aggregates 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"s0" as (
  select md5(jsonb_build_array(g0)::text)::uuid as row_id, jsonb_build_object($2::text, g0, $5::text, coalesce(to_jsonb(count(*)), $3::jsonb), $6::text, to_jsonb(sum((case when jsonb_typeof((d -> $4::text)) = 'number' then (d -> $4::text)::numeric end)))) as d, null::geometry(Geometry,4326) as geom
  from (select d, (d -> $2::text) as g0 from "in_states") t
  group by g0
)
select row_id, d as d, geom
from "s0"
-- params: ["11111111-1111-4111-8111-111111111111","name","0","pop","n","total"]"
`;

exports[`groupBy and select > select renames and the output schema restricts keys 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"s0" as (
  select row_id, jsonb_build_object($4::text, (d -> $2::text), $5::text, (d -> $3::text)) as d, geom
  from "in_states"
),
"s1" as (
  select row_id, d, geom
  from "s0"
  where ((d -> $4::text) is not null and jsonb_typeof((d -> $4::text)) <> 'null')
)
select row_id, coalesce((select jsonb_object_agg(e.key, e.value) from jsonb_each(d) e where e.key in (select jsonb_array_elements_text($6::jsonb))), '{}'::jsonb) as d, geom
from "s1"
-- params: ["11111111-1111-4111-8111-111111111111","name","pop","State","Population","[\\"State\\"]"]"
`;

exports[`inline sub-pipelines > diagnostics include sub-pipeline steps with their path 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"in_deployments" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $2::uuid
),
"in_links" as (
  select ve.id as row_id, ve.data as d,
    case when ve.geometry is null then null
      else st_setsrid(st_geomfromgeojson(ve.geometry::text), 4326)::geometry(Geometry,4326) end as geom
  from public.version_entries ve
  join public.dataset_versions v on v.id = ve.version_id
  where v.dataset_id = $3::uuid and v.ref = $4::text
),
"s0_s0" as (
  select row_id, d, geom
  from "in_deployments"
  where (case when jsonb_typeof((d -> $5::text)) = 'number' then (d -> $5::text)::numeric end) > $6::numeric
),
"s0_l1" as (
  select row_id, d, geom, (d ->> $7::text) as k0, concat_ws(' | ', (d ->> $7::text)) as kraw
  from "s0_s0"
),
"s0_r1" as (
  select row_id, d, (d ->> $8::text) as k0, concat_ws(' | ', (d ->> $8::text)) as kraw
  from "in_links"
),
"s0_rs1" as (
  select k0, to_jsonb(count(*)) as m0
  from "s0_r1"
  group by k0
),
"s0_s1" as (
  select l.row_id, l.d || jsonb_build_object($10::text, coalesce(rs.m0, $9::jsonb)) as d, l.geom
  from "s0_l1" l
  left join "s0_rs1" rs on l.k0 = rs.k0
),
"l0" as (
  select row_id, d, geom, (d ->> $11::text) as k0, concat_ws(' | ', (d ->> $11::text)) as kraw
  from "in_states"
),
"r0" as (
  select row_id, d, (d ->> $12::text) as k0, concat_ws(' | ', (d ->> $12::text)) as kraw
  from "s0_s1"
),
"rf0" as (
  select distinct on (k0) row_id, d, k0
  from "r0"
  order by k0, row_id asc
),
"s0" as (
  select l.row_id, l.d || coalesce((select jsonb_object_agg($13::text || t.key, t.value) from jsonb_each(r.d) t), '{}'::jsonb) as d, l.geom
  from "l0" l
  left join "rf0" r on l.k0 = r.k0
)
select jsonb_build_object('steps', jsonb_build_array(
  jsonb_build_object(
    'index', 0,
    'kind', $14::text,
    'rowsIn', (select count(*) from "in_deployments"),
    'rowsOut', (select count(*) from "s0_s0"),
    'fieldsAdded', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s0_s0") except (select jsonb_object_keys(d) from "in_deployments")) t(k)), '[]'::jsonb),
    'fieldsRemoved', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "in_deployments") except (select jsonb_object_keys(d) from "s0_s0")) t(k)), '[]'::jsonb),
    'path', $15::text
  ),
  jsonb_build_object(
    'index', 1,
    'kind', $16::text,
    'rowsIn', (select count(*) from "s0_s0"),
    'rowsOut', (select count(*) from "s0_s1"),
    'fieldsAdded', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s0_s1") except (select jsonb_object_keys(d) from "s0_s0")) t(k)), '[]'::jsonb),
    'fieldsRemoved', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s0_s0") except (select jsonb_object_keys(d) from "s0_s1")) t(k)), '[]'::jsonb),
    'path', $17::text,
    'join', jsonb_build_object(
      'leftMatched', (select count(*) from "s0_l1" x where exists (select 1 from "s0_r1" o where o.k0 = x.k0)),
      'leftUnmatched', (select count(*) from "s0_l1") - (select count(*) from "s0_l1" x where exists (select 1 from "s0_r1" o where o.k0 = x.k0)),
      'leftUnmatchedSamples', coalesce((select jsonb_agg(kraw order by kraw) from (select distinct kraw from "s0_l1" x where kraw <> '' and not exists (select 1 from "s0_r1" o where o.k0 = x.k0) order by kraw limit 20) s), '[]'::jsonb),
      'rightMatched', (select count(*) from "s0_r1" x where exists (select 1 from "s0_l1" o where o.k0 = x.k0)),
      'rightUnmatched', (select count(*) from "s0_r1") - (select count(*) from "s0_r1" x where exists (select 1 from "s0_l1" o where o.k0 = x.k0)),
      'rightUnmatchedSamples', coalesce((select jsonb_agg(kraw order by kraw) from (select distinct kraw from "s0_r1" x where kraw <> '' and not exists (select 1 from "s0_l1" o where o.k0 = x.k0) order by kraw limit 20) s), '[]'::jsonb),
      'multiMatchKeys', (select count(*) from (select r.k0 from "s0_r1" r where exists (select 1 from "s0_l1" o where o.k0 = r.k0) group by r.k0 having count(*) > 1) m),
      'policy', $18::text
    )
  ),
  jsonb_build_object(
    'index', 0,
    'kind', $16::text,
    'rowsIn', (select count(*) from "in_states"),
    'rowsOut', (select count(*) from "s0"),
    'fieldsAdded', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s0") except (select jsonb_object_keys(d) from "in_states")) t(k)), '[]'::jsonb),
    'fieldsRemoved', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "in_states") except (select jsonb_object_keys(d) from "s0")) t(k)), '[]'::jsonb),
    'join', jsonb_build_object(
      'leftMatched', (select count(*) from "l0" x where exists (select 1 from "r0" o where o.k0 = x.k0)),
      'leftUnmatched', (select count(*) from "l0") - (select count(*) from "l0" x where exists (select 1 from "r0" o where o.k0 = x.k0)),
      'leftUnmatchedSamples', coalesce((select jsonb_agg(kraw order by kraw) from (select distinct kraw from "l0" x where kraw <> '' and not exists (select 1 from "r0" o where o.k0 = x.k0) order by kraw limit 20) s), '[]'::jsonb),
      'rightMatched', (select count(*) from "r0" x where exists (select 1 from "l0" o where o.k0 = x.k0)),
      'rightUnmatched', (select count(*) from "r0") - (select count(*) from "r0" x where exists (select 1 from "l0" o where o.k0 = x.k0)),
      'rightUnmatchedSamples', coalesce((select jsonb_agg(kraw order by kraw) from (select distinct kraw from "r0" x where kraw <> '' and not exists (select 1 from "l0" o where o.k0 = x.k0) order by kraw limit 20) s), '[]'::jsonb),
      'multiMatchKeys', (select count(*) from (select r.k0 from "r0" r where exists (select 1 from "l0" o where o.k0 = r.k0) group by r.k0 having count(*) > 1) m),
      'policy', $19::text
    )
  )
)) as diagnostics
