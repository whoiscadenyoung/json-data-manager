// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`diagnostics > join + filter diagnostics query 1`] = `
"with "in_states" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $1::uuid
),
"in_deployments" as (
  select e.id as row_id, e.data as d, g.geom as geom
  from public.entries e
  left join public.geometries g on g.entry_id = e.id
  where e.dataset_id = $2::uuid
),
"s0" as (
  select row_id, d, geom
  from "in_states"
  where ((d -> $3::text) is not null and jsonb_typeof((d -> $3::text)) <> 'null')
),
"l1" as (
  select row_id, d, geom, btrim(lower((d ->> $4::text))) as k0, concat_ws(' | ', (d ->> $4::text)) as kraw
  from "s0"
),
"r1" as (
  select row_id, d, btrim(lower((d ->> $5::text))) as k0, concat_ws(' | ', (d ->> $5::text)) as kraw
  from "in_deployments"
),
"rs1" as (
  select k0, to_jsonb(count(*)) as m0
  from "r1"
  group by k0
),
"s1" as (
  select l.row_id, l.d || jsonb_build_object($7::text, coalesce(rs.m0, $6::jsonb)) as d, l.geom
  from "l1" l
  left join "rs1" rs on l.k0 = rs.k0
)
select jsonb_build_object('steps', jsonb_build_array(
  jsonb_build_object(
    'index', 0,
    'kind', $8::text,
    'rowsIn', (select count(*) from "in_states"),
    'rowsOut', (select count(*) from "s0"),
    'fieldsAdded', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s0") except (select jsonb_object_keys(d) from "in_states")) t(k)), '[]'::jsonb),
    'fieldsRemoved', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "in_states") except (select jsonb_object_keys(d) from "s0")) t(k)), '[]'::jsonb)
  ),
  jsonb_build_object(
    'index', 1,
    'kind', $9::text,
    'rowsIn', (select count(*) from "s0"),
    'rowsOut', (select count(*) from "s1"),
    'fieldsAdded', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s1") except (select jsonb_object_keys(d) from "s0")) t(k)), '[]'::jsonb),
    'fieldsRemoved', coalesce((select jsonb_agg(k order by k) from ((select jsonb_object_keys(d) from "s0") except (select jsonb_object_keys(d) from "s1")) t(k)), '[]'::jsonb),
    'join', jsonb_build_object(
      'leftMatched', (select count(*) from "l1" x where exists (select 1 from "r1" o where o.k0 = x.k0)),
      'leftUnmatched', (select count(*) from "l1") - (select count(*) from "l1" x where exists (select 1 from "r1" o where o.k0 = x.k0)),
      'leftUnmatchedSamples', coalesce((select jsonb_agg(kraw order by kraw) from (select distinct kraw from "l1" x where kraw <> '' and not exists (select 1 from "r1" o where o.k0 = x.k0) order by kraw limit 20) s), '[]'::jsonb),
      'rightMatched', (select count(*) from "r1" x where exists (select 1 from "l1" o where o.k0 = x.k0)),
      'rightUnmatched', (select count(*) from "r1") - (select count(*) from "r1" x where exists (select 1 from "l1" o where o.k0 = x.k0)),
      'rightUnmatchedSamples', coalesce((select jsonb_agg(kraw order by kraw) from (select distinct kraw from "r1" x where kraw <> '' and not exists (select 1 from "l1" o where o.k0 = x.k0) order by kraw limit 20) s), '[]'::jsonb),
      'multiMatchKeys', (select count(*) from (select r.k0 from "r1" r where exists (select 1 from "l1" o where o.k0 = r.k0) group by r.k0 having count(*) > 1) m),
      'policy', $10::text
    )
  )
)) as diagnostics
-- params: ["11111111-1111-4111-8111-111111111111","22222222-2222-4222-8222-222222222222","name","id","stateId","0","n","filter","join","summarize"]"
`;

