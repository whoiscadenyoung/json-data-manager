{
  "name": "@caden/json-cms",
  "version": "0.1.0",
  "description": "A json cms component for Convex.",
  "keywords": [
    "component",
    "convex"
  ],
  "homepage": "https://github.com/whoiscadenyoung/json-data-manager#readme",
  "bugs": {
    "url": "https://github.com/whoiscadenyoung/json-data-manager/issues"
  },
  "license": "Apache-2.0",
  "repository": "github:whoiscadenyoung/json-data-manager",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "module": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/ui": {
      "types": "./dist/react/ui/index.d.ts",
      "default": "./dist/react/ui/index.js"
    },
    "./react/ui/styles.css": "./src/react/ui/styles.css",
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:backend": "convex dev --typecheck-components",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'bun run build:codegen' --initial",
    "predev": "path-exists .env.local dist || (bun run build && convex dev --once)",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && bun run build",
    "build:clean": "rm -rf dist *.tsbuildinfo .cache/*.tsbuildinfo && bun run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "all": "run-p -r 'dev:*' 'test:watch'",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preversion": "bun ci && bun run build:clean && run-p test lint typecheck",
    "prepublishOnly": "bun whoami || bun login",
    "alpha": "bun version prerelease --preid alpha && bun publish --tag alpha && git push --follow-tags",
    "release": "bun version patch && bun publish && git push --follow-tags",
    "version": "vim -c 'normal o' -c 'normal o## '$npm_package_version CHANGELOG.md && prettier -w CHANGELOG.md && git add CHANGELOG.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@convex-dev/workflow": "0.4.6",
    "@convex-dev/workpool": "0.4.11",
    "@rjsf/core": "^6.8.0",
    "@rjsf/shadcn": "^6.8.0",
    "@rjsf/utils": "^6.8.0",
    "@rjsf/validator-ajv8": "^6.8.0",
    "@turf/bbox": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-json-schema": "^0.8.1",
    "convex-helpers": "^0.1.123",
    "geojson": "^0.5.0",
    "lucide-react": "^1.39.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "chokidar-cli": "3.0.0",
    "convex": "1.45.0",
    "convex-test": "0.0.56",
    "globals": "^17.12.0",
    "npm-run-all2": "9.0.3",
    "path-exists-cli": "2.0.0",
    "pkg-pr-new": "^0.0.88",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "react": "^19.2.8"
  }
}
