{
  "name": "json-data-manager",
  "private": true,
  "workspaces": [
    "app",
    "packages/*",
    "demo/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=app",
    "demo:deploy-source": "bun --filter=@caden/deploy-source-demo run dev",
    "build": "turbo run build",
    "preview": "bun --filter=app run preview",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.11.13"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10"
  },
  "packageManager": "bun@1.3.5"
}
