{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "jsdoc",
    "react",
    "import",
    "promise",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/no-empty-file": "warn",
    "no-underscore-dangle": "off",
    "typescript/no-dynamic-delete": "error",
    "import/no-dynamic-require": "error",
    "react/button-has-type": "warn",
    "complexity": ["warn", { "max": 10 }],
    "jsdoc/empty-tags": "warn",
    "eslint/no-alert": "error",
    "unicorn/no-array-for-each": "error",
    "oxc/no-barrel-file": "error",
    "eslint/no-bitwise": "error",
    "react/no-clone-element": "error",
    "oxc/no-const-enum": "error",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-eq-null": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-non-null-assertion": "error",
    "oxc/no-optional-chaining": "error",
    "eslint/no-param-reassign": "error",
    "node/no-path-concat": "error",
    "no-plusplus": "error",
    "react/no-react-children": "error",
    "no-regex-spaces": "error",
    // "import/no-relative-parent-imports": "error",
    "typescript/no-require-imports": "error",
    "react/no-unknown-property": "error",
    // "no-use-before-define": ["warn", { "allowNamedExports": true }],
    "no-var": "error",
    "react/prefer-function-component": "error",
    "unicorn/prefer-number-properties": "error",
    "import/no-named-as-default-member": "off",
    "typescript/promise-function-async": "error",
    "promise/spec-only": "error",
    "react/syntax": "error",
    "react/unsupported-syntax": "warn",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    // Module boundaries (ADR 0014): feature subfolders are private, and
    // optional modules (app-builder, layer-styles) are wired only by routes.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^#/features/[^/]+/[^/]+/",
            "message": "Feature subfolders are private: import from the feature's root entry files (#/features/<name> or #/features/<name>/<entry>) (ADR 0014)."
          },
          {
            "regex": "^#/features/(app-builder|layer-styles)(/|$)",
            "message": "Optional modules are wired only by routes; core and other features expose extension slots instead (ADR 0011, 0012, 0014)."
          }
        ]
      }
    ]
  },
  "settings": {
    "jsx-a11y": {
      "components": {},
      "attributes": {}
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19.8.2",
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": ["packages/ui/src/components", "packages/ui/src/niko-table"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "jsdoc",
        "react",
        "vitest",
        "import",
        "promise"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "import/no-default-export": "error"
      }
    },
    {
      // Features may build on each other's public entries, but the graph must
      // stay acyclic (ADR 0014).
      "files": ["app/src/**"],
      "rules": {
        "import/no-cycle": "error"
      }
    },
    {
      // Routes compose everything, optional modules included.
      "files": ["app/src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^#/features/[^/]+/[^/]+/",
                "message": "Feature subfolders are private: import from the feature's root entry files (#/features/<name> or #/features/<name>/<entry>) (ADR 0014)."
              }
            ]
          }
        ]
      }
    },
    {
      // Core never depends on features; features build on core.
      "files": ["app/src/components/**", "app/src/lib/**", "app/src/integrations/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^#/features/",
                "message": "Core (src/components, src/lib, src/integrations) never imports features (ADR 0014)."
              }
            ]
          }
        ]
      }
    }
  ]
}
